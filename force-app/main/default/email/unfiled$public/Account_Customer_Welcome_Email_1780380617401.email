<html>
<head>
	<title></title>
</head>
<body style="height: auto; min-height: auto;">
<table border="0" cellpadding="0" cellspacing="0" style="background-color:#f0f2f5;padding:40px 0;" width="100%">
	
		<tr>
			<td align="center">
			<table border="0" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;overflow:hidden;" width="600">
				
					<tr>
						<td style="background-color:#0070D2;padding:24px 32px;">
						<table border="0" cellpadding="0" cellspacing="0" width="100%">
							
								<tr>
									<td><span style="color:#ffffff;font-size:19px;font-weight:bold;">Notification Framework</span></td>
									<td align="right"><span style="background-color:#005fb2;color:#c8e4ff;font-size:10px;font-weight:bold;padding:4px 12px;border-radius:12px;">ACCOUNT UPDATE</span></td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="background-color:#0070D2;padding:0 32px 32px;">
						<p style="margin:0;color:#e8f4ff;font-size:13px;font-weight:bold;">✓ Account status updated successfully</p>
						</td>
					</tr>
					<tr>
						<td style="padding:32px 32px 24px 32px;">
						<p style="margin:0 0 6px 0;color:#1a1a1a;font-size:17px;font-weight:bold;">Hi {{{Owner_Name}}},</p>

						<p style="margin:0;color:#555555;font-size:14px;line-height:1.8;">Great news! The account <strong style="color:#0070D2;">{{{Account_Name}}}</strong> has been updated to <strong>Customer</strong> status. Please review the details below and take the necessary follow-up action.</p>
						</td>
					</tr>
					<tr>
						<td style="padding:0 32px 24px;">
						<table border="0" cellpadding="0" cellspacing="0" style="border:1px solid #e2e8ef;border-radius:6px;overflow:hidden;" width="100%">
							
								<tr>
									<td colspan="2" style="background-color:#f4f7fa;padding:11px 20px;border-bottom:1px solid #e2e8ef;"><span style="color:#555555;font-size:11px;font-weight:bold;letter-spacing:1.2px;">ACCOUNT DETAILS</span></td>
								</tr>
								<tr>
									<td style="padding:12px 20px;width:38%;background-color:#fafbfc;border-bottom:1px solid #eeeeee;"><span style="color:#888888;font-size:13px;">Account Name</span></td>
									<td style="padding:12px 20px;border-bottom:1px solid #eeeeee;"><span style="color:#1a1a1a;font-size:13px;font-weight:bold;">{{{Account_Name}}}</span></td>
								</tr>
								<tr>
									<td style="padding:12px 20px;width:38%;background-color:#fafbfc;border-bottom:1px solid #eeeeee;"><span style="color:#888888;font-size:13px;">Industry</span></td>
									<td style="padding:12px 20px;border-bottom:1px solid #eeeeee;"><span style="color:#1a1a1a;font-size:13px;">{{{Industry}}}</span></td>
								</tr>
								<tr>
									<td style="padding:12px 20px;width:38%;background-color:#fafbfc;border-bottom:1px solid #eeeeee;"><span style="color:#888888;font-size:13px;">Annual Revenue</span></td>
									<td style="padding:12px 20px;border-bottom:1px solid #eeeeee;"><span style="color:#1a1a1a;font-size:13px;">{{{AnnualRevenue}}}</span></td>
								</tr>
								<tr>
									<td style="padding:12px 20px;width:38%;background-color:#fafbfc;"><span style="color:#888888;font-size:13px;">Updated By</span></td>
									<td style="padding:12px 20px;"><span style="color:#1a1a1a;font-size:13px;">{{{Changed_By}}}</span></td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="padding:0 32px 32px;">
						<table border="0" cellpadding="0" cellspacing="0" style="border-radius:6px;border-left:4px solid #F4A100;background-color:#fffaed;" width="100%">
							
								<tr>
									<td style="padding:14px 20px;"><span style="color:#a75c00;font-size:13px;line-height:1.6;">⚠ <strong>Action Required:</strong> Please follow up within <strong>24 hours</strong> to schedule an onboarding call.</span></td>
								</tr>
							
						</table>
						</td>
					</tr>
					<tr>
						<td style="background-color:#f4f7fa;padding:16px 32px;border-top:1px solid #e2e8ef;"><span style="color:#aaaaaa;font-size:11px;">© 2026 Hypermatica. This is an automated notification - please do not reply to this email.</span></td>
					</tr>
				
			</table>
			</td>
		</tr>
	
</table>
</body>
</html>